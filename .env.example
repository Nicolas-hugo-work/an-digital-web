# Tarjeta AN Club (Apple Wallet). Copia a .env.local (local) o carga en Vercel → Settings → Environment Variables.
# NUNCA subas los valores reales al repo.

# Vercel: contenido de cada archivo en base64 (marcar como Sensitive)
APPLE_PASS_CERT_B64=
APPLE_PASS_KEY_B64=
APPLE_WWDR_CERT_B64=
APPLE_PASS_KEY_PASSPHRASE=

# Local: carpeta privada con pass.pem, anclub.key y wwdr.pem (en vez de las *_B64)
APPLE_CERTS_DIR=

# Clave del endpoint de prueba /api/wallet/prueba (16+ caracteres aleatorios)
WALLET_TEST_KEY=
